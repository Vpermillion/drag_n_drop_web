{
  "name": "uru-business-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "tsx tests/browser.ts",
    "backup": "node --env-file-if-exists=.env --import tsx server/backup.ts",
    "restore": "tsx server/restore.ts",
    "format": "prettier --write src server tests docs *.json *.html *.ts README.md",
    "format:check": "prettier --check src server tests docs *.json *.html *.ts README.md",
    "build:pages": "tsc --noEmit && vite build --mode pages --outDir dist-pages",
    "test:pages": "tsx tests/pages-browser.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.23.15",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.56.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
